{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MichaelWave369/PhiFieldLab/blob/main/src/phifieldlab/schemas/d1.schema.json",
  "title": "ΦField Lab D1 - Research Mission Proposal (no execution)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "mission_id",
    "domain",
    "title",
    "question",
    "status",
    "provenance",
    "scope",
    "evidence",
    "evaluation",
    "candidates",
    "resources",
    "risk",
    "permissions"
  ],
  "properties": {
    "protocol": {
      "const": "PHIFIELD_DISCOVERY_D1_MISSION_V1"
    },
    "mission_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$",
      "minLength": 3,
      "maxLength": 64
    },
    "domain": {
      "type": "string",
      "enum": [
        "science",
        "software",
        "networking",
        "engineering",
        "environment",
        "creative",
        "mathematics"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 8,
      "maxLength": 120
    },
    "question": {
      "type": "string",
      "minLength": 20,
      "maxLength": 600
    },
    "status": {
      "const": "PROPOSAL_ONLY"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "authority",
        "attested"
      ],
      "properties": {
        "origin": {
          "const": "PROPOSED"
        },
        "authority": {
          "const": "NONE"
        },
        "attested": {
          "const": false
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "in_scope",
        "out_of_scope"
      ],
      "properties": {
        "in_scope": {
          "type": "string",
          "minLength": 20,
          "maxLength": 1000
        },
        "out_of_scope": {
          "type": "string",
          "minLength": 15,
          "maxLength": 1000
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "source_description",
        "replay_plan"
      ],
      "properties": {
        "source_kind": {
          "type": "string",
          "enum": [
            "UNKNOWN",
            "SIMULATED",
            "LITERATURE",
            "OBSERVED"
          ]
        },
        "source_description": {
          "type": "string",
          "minLength": 15,
          "maxLength": 1000
        },
        "replay_plan": {
          "type": "string",
          "minLength": 15,
          "maxLength": 1000
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "metric",
        "baseline",
        "negative_control",
        "success_criterion",
        "failure_criterion",
        "uncertainty"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 15,
          "maxLength": 1000
        },
        "metric": {
          "type": "string",
          "minLength": 8,
          "maxLength": 300
        },
        "baseline": {
          "type": "string",
          "minLength": 15,
          "maxLength": 500
        },
        "negative_control": {
          "type": "string",
          "minLength": 15,
          "maxLength": 500
        },
        "success_criterion": {
          "type": "string",
          "minLength": 15,
          "maxLength": 500
        },
        "failure_criterion": {
          "type": "string",
          "minLength": 15,
          "maxLength": 500
        },
        "uncertainty": {
          "type": "string",
          "minLength": 15,
          "maxLength": 500
        }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "hypothesis",
          "prediction",
          "falsifier"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^H[1-4]$"
          },
          "hypothesis": {
            "type": "string",
            "minLength": 15,
            "maxLength": 500
          },
          "prediction": {
            "type": "string",
            "minLength": 15,
            "maxLength": 500
          },
          "falsifier": {
            "type": "string",
            "minLength": 15,
            "maxLength": 500
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_runtime_minutes",
        "max_compute_units",
        "max_external_cost_usd"
      ],
      "properties": {
        "max_runtime_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 240
        },
        "max_compute_units": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_external_cost_usd": {
          "const": 0
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "potential_harms",
        "stop_condition"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "LOW",
            "MODERATE",
            "HIGH"
          ]
        },
        "potential_harms": {
          "type": "string",
          "minLength": 15,
          "maxLength": 1000
        },
        "stop_condition": {
          "type": "string",
          "minLength": 15,
          "maxLength": 500
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator_approval_required",
        "local_execution",
        "network_access",
        "repository_writes",
        "publication",
        "external_spend"
      ],
      "properties": {
        "operator_approval_required": {
          "const": true
        },
        "local_execution": {
          "const": false
        },
        "network_access": {
          "const": false
        },
        "repository_writes": {
          "const": false
        },
        "publication": {
          "const": false
        },
        "external_spend": {
          "const": false
        }
      }
    }
  }
}
